<?xml version="1.0" encoding="utf-8"?>
<!-- Shelter opts out of backup entirely (see android:allowBackup="false"); these
     rules formalize that for Android 12+ cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>